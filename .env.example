# Template for the repo-root .env file. Copy to .env and fill in real
# values locally — .env itself is gitignored and must never be committed.
# Loaded via: set -a && source .env && set +a
# (see apps/api/README.md for the GITHUB_APP_PRIVATE_KEY multi-line-PEM gotcha)

# --- apps/api: translation providers (also used by packages/eval) ---

# Anthropic API key. Required for any /v1/translate request that routes to
# the Anthropic provider (apps/api/src/router/index.ts), and for
# packages/eval's translate condition.
ANTHROPIC_API_KEY=

# OpenAI API key. Required for any /v1/translate request that routes to the
# OpenAI provider, and for packages/eval's translate condition.
OPENAI_API_KEY=

# Optional override for the OpenAI API base URL (e.g. an OpenAI-compatible
# proxy). Leave empty to use OpenAI's default endpoint.
OPENAI_BASE_URL=

# --- apps/api: auth ---

# Shared bearer token that apps/api's /v1/* routes require in the
# Authorization header. apps/api refuses to start if this is unset.
API_AUTH_TOKEN=

# --- apps/api: model overrides (optional) ---

# Anthropic model ID used for translation requests. Defaults to
# "claude-sonnet-5" if unset.
API_ANTHROPIC_MODEL=

# OpenAI model ID used for translation requests. Defaults to "gpt-4o" if
# unset.
API_OPENAI_MODEL=

# --- apps/api: server ---

# Port apps/api's HTTP server listens on. Defaults to 8787 if unset.
PORT=

# --- apps/api: GitHub App (required only for /v1/open-pr) ---

# GitHub App ID used to authenticate as the App.
GITHUB_APP_ID=

# The GitHub App's private key (full multi-line PEM). See
# apps/api/README.md for how to set a multi-line value in this file.
GITHUB_APP_PRIVATE_KEY=

# The App installation ID for the target GitHub account/org. Must be
# numeric; a non-numeric value is treated the same as if unset.
GITHUB_APP_INSTALLATION_ID=

# --- packages/cli ---

# Bearer token the CLI sends to apps/api. Preferred over the CLI's
# --api-token flag, which leaks into shell history/process listings.
LOCALIZE_API_TOKEN=

# --- packages/eval ---

# Overrides for the model IDs used by packages/eval's translate condition.
# Both default to the same values as API_ANTHROPIC_MODEL/API_OPENAI_MODEL's
# defaults ("claude-sonnet-5" / "gpt-4o") if unset.
EVAL_ANTHROPIC_MODEL=
EVAL_OPENAI_MODEL=

# Forces packages/eval's translate condition to use a single provider
# ("anthropic" or "openai") instead of its default hash-based split.
# Leave empty to use the default behavior.
EVAL_FORCE_PROVIDER=
