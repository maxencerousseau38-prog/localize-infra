# Supabase — server-side only, deliberately not NEXT_PUBLIC_.
#
# Every Supabase call in this app is made from the server (sign-in is a Server
# Action, session refresh happens in the proxy), so the browser never needs
# these and the CSP keeps `connect-src 'self'`.
#
# The publishable key is not a secret — RLS is what protects the data — but it
# is not needed client-side here either.
#
# Project: localize-infra, region eu-west-3 (Paris, for invariant 5).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
