{
  "name": "@localize-infra/api",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "pretest": "node -e \"require('fs').rmSync('../../packages/schemas/tsconfig.tsbuildinfo',{force:true});require('fs').rmSync('../../services/github-app/tsconfig.tsbuildinfo',{force:true})\" && npm run build -w @localize-infra/schemas -w @localize-infra/github-app",
    "test": "vitest run",
    "predev": "node -e \"require('fs').rmSync('../../packages/schemas/tsconfig.tsbuildinfo',{force:true});require('fs').rmSync('../../services/github-app/tsconfig.tsbuildinfo',{force:true})\" && npm run build -w @localize-infra/schemas -w @localize-infra/github-app",
    "dev": "tsx watch src/index.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.0",
    "@localize-infra/github-app": "*",
    "@localize-infra/schemas": "*",
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
