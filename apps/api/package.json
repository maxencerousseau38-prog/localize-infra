{
  "name": "@localize-infra/api",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "pretest": "npm run build -w @localize-infra/schemas -w @localize-infra/github-app",
    "test": "vitest run",
    "predev": "npm run build -w @localize-infra/schemas -w @localize-infra/github-app",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p eval/tsconfig.json",
    "eval:models": "tsx eval/run.ts",
    "eval:robustness": "tsx eval/robustness.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.0",
    "@localize-infra/github-app": "*",
    "@localize-infra/schemas": "*",
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
