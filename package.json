{
  "name": "localize-infra",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": ">=20"
  },
  "workspaces": ["packages/*", "apps/*", "services/*"],
  "scripts": {
