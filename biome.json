{
  "$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
  "organizeImports": {
    "enabled": true
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single"
    }
  },
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignore": [
      "packages/eval/src/corpus/data/**",
      "packages/eval/src/human-eval/export/**",
      "packages/eval/src/report/benchmarks.json",
      "**/dist/**",
      "package.json",
      ".mcp.json",
      ".agents/**",
      ".claude/**",
      "skills-lock.json"
    ]
  }
}
