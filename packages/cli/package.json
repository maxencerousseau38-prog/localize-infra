{
  "name": "@localize-infra/cli",
  "version": "0.2.0",
  "description": "Extract hardcoded UI strings from a React codebase, translate them, and open a pull request with the locale files.",
  "keywords": [
    "i18n",
    "l10n",
    "localization",
    "internationalization",
    "translation",
    "react",
    "nextjs",
    "cli"
  ],
  "private": false,
  "license": "MIT",
  "type": "module",
  "bin": {
    "localize-infra": "dist/index.js"
  },
  "scripts": {
    "prepublishOnly": "npm run build -w @localize-infra/schemas -w @localize-infra/core && npm run build",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "dev": "tsx src/index.ts"
  },
  "dependencies": {
    "@localize-infra/core": "^0.1.0",
    "@localize-infra/schemas": "^0.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/.tsbuildinfo",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maxencerousseau38-prog/localize-infra.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/maxencerousseau38-prog/localize-infra#readme",
  "bugs": {
    "url": "https://github.com/maxencerousseau38-prog/localize-infra/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
