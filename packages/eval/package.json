{
  "name": "@localize-infra/eval",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./benchmarks.json": "./src/report/benchmarks.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "corpus:build": "tsx src/corpus/build.ts",
    "translate:run": "tsx src/conditions/translate.ts",
    "human-eval:generate": "tsx src/human-eval/export.ts",
    "report:build": "tsx src/report/build.ts",
    "benchmarks:build": "tsx src/report/benchmarks.ts"
  },
  "dependencies": {
    "@formatjs/icu-messageformat-parser": "^2.9.4",
    "@localize-infra/schemas": "*",
    "gettext-parser": "^8.0.0"
  },
  "devDependencies": {
    "@types/gettext-parser": "^4.0.4",
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts"
}
